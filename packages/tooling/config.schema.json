{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository tooling",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "translations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "app": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "database": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tooling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "const": false
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "devCommand": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "profiles": {
                "type": "array",
                "items": {
                  "enum": ["dev", "push", "ci"]
                }
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "devFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "translations": {
      "type": "object",
      "required": ["directory", "source"],
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "pluralExceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1
        },
        "maxSpecificity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "object",
          "required": ["dist", "initialKB", "chunkKB"],
          "additionalProperties": false,
          "properties": {
            "dist": {
              "type": "string"
            },
            "initialKB": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "chunkKB": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "vendors": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare", "files"],
      "properties": {
        "prepare": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
