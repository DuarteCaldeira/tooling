      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    },
    "sass": {
      "optional": true
    }
  },
  "dependencies": {
    "es-module-lexer": "2.3.2",
    "semver": "7.8.6"
