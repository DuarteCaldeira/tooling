{
  "name": "@dcaldeira/tooling",
  "version": "0.3.0",
  "description": "Shared checks and change detection for local development and GitHub Actions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DuarteCaldeira/tooling.git",
    "directory": "packages/tooling"
  },
  "bin": {
    "tooling": "runner/cli.mjs"
  },
  "exports": {
    ".": "./runner/index.mjs",
