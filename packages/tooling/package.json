    "./checks/*": "./checks/*",
    "./release": "./release/evidence.mjs",
    "./schema": "./config.schema.json"
  },
  "files": [
    "configs",
    "checks",
    "runner",
    "release",
    "templates",
    "config.schema.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "prettier": ">=3 <4",
    "eslint": ">=9 <11",
    "typescript-eslint": ">=8 <9",
    "@eslint/js": ">=9 <11",
    "eslint-plugin-jsx-a11y": ">=6 <7",
    "eslint-plugin-react-hooks": ">=7 <8",
    "globals": ">=16 <18",
    "postcss-scss": ">=4 <5",
    "vitest": ">=3 <6",
    "@playwright/test": ">=1.50 <2",
    "knip": ">=5 <7",
    "postcss": ">=8 <9",
    "typescript": ">=5 <7",
    "@axe-core/playwright": ">=4 <5",
    "sass": ">=1 <2"
  },
