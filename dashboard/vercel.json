{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "vite build && node build.mjs",
  "installCommand": "npm ci --ignore-scripts --workspaces=false",
  "outputDirectory": "dist",
  "functions": {
    "api/discussions.js": { "includeFiles": "server/discussion-manifest.json", "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/data.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
    }
  ]
}
