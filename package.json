{
  "name": "tooling",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tooling"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack:tooling": "npm pack -w packages/tooling",
    "check": "node scripts/check-changed.mjs",
    "eval:plugin": "node scripts/eval-plugin.mjs",
    "format:check": "prettier --check .",
    "test:browser": "node --test tests/a11y.integration.mjs tests/dashboard.browser.mjs",
    "test:dashboard:mobile": "npm --prefix dashboard run build:web && node --test tests/dashboard-mobile.browser.mjs",
    "test:dashboard:runtime": "npm --prefix dashboard run build:web && node --test tests/dashboard-runtime.browser.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "yaml": "2.9.1",
    "prettier": "3.9.10",
    "postcss-scss": "4.0.9",
    "postcss": "8.5.32",
    "typescript": "6.0.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0"
  }
}
